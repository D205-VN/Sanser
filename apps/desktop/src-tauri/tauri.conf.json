{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sanser",
  "version": "2.0.4",
  "identifier": "com.sanser.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Sanser 2.0.4",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "visible": true,
        "center": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright © 2026 Sanser",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Low-latency remote desktop and game streaming",
    "longDescription": "Sanser 2.0.4 is a secure, low-latency remote desktop and remote game streaming application.",
    "targets": "all",
    "externalBin": [],
    "resources": [],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/D205-VN/Sanser/releases/latest/download/updater-latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMEExMjg0NDhBQjBDOEMKUldTTURLdEloQklLa3RBQlVRNXNjZ2dJZjgzMjdrb0xhYTVveGpaZXJQcUNLdmlWeXJaZXh6NloK"
    }
  }
}
