{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/sanser-host-windows",
      "binaries/sanser-client-windows",
      "binaries/sanser-uac-service"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": [
          "English"
        ]
      }
    }
  }
}
