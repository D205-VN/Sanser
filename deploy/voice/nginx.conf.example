# Include in nginx's http {} context. Replace domain/certificate paths first.
# API must run on this host at 127.0.0.1:5174; SFU HTTP is NEVER proxied.
map $http_upgrade $sanser_voice_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name voice.example.invalid;
    ssl_certificate /etc/ssl/sanser/fullchain.pem;
    ssl_certificate_key /etc/ssl/sanser/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # LiveKit SDK puts the join token in the query. Disable query-bearing
    # access logs and request-line errors in this vhost, including the parent
    # HTTP/websocket locations. Check external CDN/WAF logging separately.
    access_log off;
    error_log /dev/null crit;

    location /twirp/ { return 404; }
    location /agent { return 404; }
    location /debug/ { return 404; }
    location / {
        proxy_pass http://127.0.0.1:5174;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $sanser_voice_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }
}
