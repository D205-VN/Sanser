DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# NETWORK_MODE=direct | relay | default | tailscale
# direct: WebRTC host/server-reflexive candidates via STUN; no Tailscale required.
# relay: TURN-only WebRTC; TURN_URLS and credentials are required.
# default: backward-compatible automatic policy. tailscale: optional legacy mode.
NETWORK_MODE=direct

# all | relay; only used by NETWORK_MODE=default.
# direct always uses all, relay always uses relay.
ICE_TRANSPORT_POLICY=all

# Direct WebRTC discovery
STUN_URLS=stun:stun.l.google.com:19302

# Required for NETWORK_MODE=relay. Comma-separate UDP/TCP/TLS URLs if available.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional compatibility mode only
TAILSCALE_USE_STUN=0

# App/signaling server binding
HOST=127.0.0.1
PORT=5174
