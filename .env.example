# Sanser 2.0.3 — copy to .env and replace placeholders locally.
# Never commit .env or production credentials.
SANSER_VERSION=2.0.3
SANSER_PROTOCOL_VERSION=2

# Development defaults. Production deploys the API publicly over HTTPS and
# bake that URL into the installer; end users never enter or edit it.
SERVER_HOST=127.0.0.1
SERVER_PORT=5174
VITE_SANSER_SERVER_URL=http://127.0.0.1:5174

# PostgreSQL hosted by Neon is the only application database. Prefer a pooled
# Neon endpoint and keep TLS required.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/sanser?sslmode=require
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10

# Current compatibility policy: auto | direct | relay. The opt-in P2P v2
# target uses direct candidates only and does not consume TURN settings yet.
NETWORK_MODE=auto
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=

# Prefer a TURN REST shared secret so the server can mint short-lived credentials.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Static TURN credentials are development-only compatibility settings.
TURN_USERNAME=
TURN_CREDENTIAL=

RUST_LOG=info
# Exact development origins. In production keep both Tauri application origins
# and add only the HTTPS web origins you actually serve.
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,tauri://localhost,http://tauri.localhost
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REQUEST_TIMEOUT_SECONDS=15
REQUEST_BODY_LIMIT_BYTES=262144
RATE_LIMIT_REQUESTS_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_TEN_MINUTES=8
DEVICE_OFFLINE_AFTER_SECONDS=20
PENDING_SESSION_TTL_SECONDS=30
NATIVE_BASE_PORT=50000
SESSION_CREDENTIAL_TTL_SECONDS=60

# Generate a unique value for each deployment. The session key must use standard
# base64 encoding of at least 32 random bytes (`npm run secrets:init`).
SESSION_CREDENTIAL_KEY=
