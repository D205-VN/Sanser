# Sanser 2.0.0 — copy to .env and replace placeholders locally.
# Never commit .env or production credentials.
SANSER_VERSION=2.0.0
SANSER_PROTOCOL_VERSION=2

SERVER_HOST=127.0.0.1
SERVER_PORT=5174
PUBLIC_BASE_URL=http://127.0.0.1:5174

# local uses SQLite and requires no PostgreSQL installation.
# shared uses DATABASE_URL and the versioned PostgreSQL migrations.
STORAGE_MODE=local
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/sanser
SQLITE_PATH=./data/sanser.db

# auto | direct | relay
NETWORK_MODE=auto
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=

# Prefer a TURN REST shared secret so the server can mint short-lived credentials.
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Static TURN credentials are development-only compatibility settings.
TURN_USERNAME=
TURN_CREDENTIAL=

RUST_LOG=info
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,tauri://localhost
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Generate independent random values for non-local deployments.
TOKEN_PEPPER=
DISCOVERY_SIGNING_KEY=
